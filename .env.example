# API Configuration
# Local development:
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
# NEXT_PUBLIC_CMS_API_URL=http://localhost:4000/api
# Production (Railway):
NEXT_PUBLIC_API_URL=https://api-production-8db8.up.railway.app/api
NEXT_PUBLIC_CMS_API_URL=https://api-production-8db8.up.railway.app/api

# Database
# Get your Neon PostgreSQL connection string from https://neon.tech/
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full

# JWT Authentication
# Generate a secure random string for production
JWT_SECRET=your-secure-random-jwt-secret-key-here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Google OAuth
# Get your Google Client ID from https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Crypto Payment Configuration
NEXT_PUBLIC_RECEIVING_WALLET=your-wallet-address-here
